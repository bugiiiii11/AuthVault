{
  "permissions": {
    "allow": [
      "Bash(claude mcp:*)",
      "Bash(pnpm --version)",
      "Bash(npx turbo:*)",
      "Bash(corepack enable:*)",
      "Bash(corepack prepare:*)"
    ],
    "additionalDirectories": [
      "c:\\Users\\cryptomeda\\Desktop\\Swarm\\myprojects\\AuthVault\\.claude"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-internal-urls.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit-all.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|WebFetch|WebSearch|Bash|Grep|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/scan-injection.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
